# ==============================================================================
# V-Blood Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Google Gemini API (Recommended) ---
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Target Model Identifier
# When GEMINI_API_KEY is active: gemini-2.5-flash (default), gemini-1.5-flash, gemini-1.5-pro
# When OPENAI_API_KEY is active: gpt-4o-mini (default), gpt-4o
LLM_MODEL=gemini-2.5-flash

# Base URL (Optional - defaults to Gemini's endpoint if GEMINI_API_KEY is set)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI: https://api.openai.com/v1
# Local Ollama: http://localhost:11434/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Alternative Providers (OpenAI, Anthropic, Local) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VBLOOD_LLM_API_KEY=

# --- Application Core ---
VBLOOD_ENV=development           # development | staging | production
VBLOOD_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
VBLOOD_VERSION=0.5.0
VBLOOD_API_HOST=0.0.0.0
VBLOOD_API_PORT=8000

# --- Artifact & Simulation Storage ---
VBLOOD_ARTIFACT_DIR=./simulation_outputs

# --- Database (Optional — PostgreSQL) ---
# VBLOOD_DB_HOST=localhost
# VBLOOD_DB_PORT=5432
# VBLOOD_DB_NAME=vblood
# VBLOOD_DB_USER=vblood_user
# VBLOOD_DB_PASSWORD=
