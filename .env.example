# V-Blood Environment Configuration Template
#
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
#
# --- Application ---
VBLOOD_ENV=development           # development | staging | production
VBLOOD_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
VBLOOD_VERSION=0.1.0

# --- Database (PostgreSQL — not required for milestone 1 engine) ---
# VBLOOD_DB_HOST=localhost
# VBLOOD_DB_PORT=5432
# VBLOOD_DB_NAME=vblood
# VBLOOD_DB_USER=vblood_user
# VBLOOD_DB_PASSWORD=REPLACE_ME

# --- API ---
VBLOOD_API_HOST=0.0.0.0
VBLOOD_API_PORT=8000

# --- LLM (not used in milestone 1) ---
# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME

# --- Artifact storage ---
VBLOOD_ARTIFACT_DIR=./simulation_outputs
