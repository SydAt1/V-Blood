# Python
__pycache__/
*.py[oc]
*.pyo
*.pyd
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg
*.whl
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.env.local
.env.*.local

# Environment / secrets (never commit real values)
.env
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Type checking
.mypy_cache/
.dmypy.json
