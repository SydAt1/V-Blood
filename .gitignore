*.ipynb

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data – exclude large raw data, keep processed schemas
data/raw/
data/processed/*.parquet
data/processed/*.csv

# Model artifacts – exclude large binary model files
models/model_registry/*.pkl
models/model_registry/*.pt
models/model_registry/*.h5
models/model_registry/*.onnx

# Simulation outputs (potentially large)
simulation_outputs/

# Logs
*.log
logs/

# uv
.uv/
uv.lock

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
