# ==============================================================================
# V-Blood Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to customize frontend settings:
#   cp .env.example .env
#
# Vite API Base URL:
# - Leave blank to use relative paths with Vite's dev proxy (http://127.0.0.1:8000)
# - Set explicitly for remote staging/production backend: https://api.vblood.example.com
VITE_API_BASE_URL=
